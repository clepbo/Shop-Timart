# Password for the owner's Studio at /admin (change this!)
ADMIN_PASSWORD=change-me

# --- AI virtual try-on (optional) ---
# Without these, the Fit Studio shows illustrated previews.
# With them, every uploaded product photo is automatically rendered on each body profile.
# Get a token at https://replicate.com/account/api-tokens and use the version id of an
# IDM-VTON-compatible try-on model (inputs: garm_img, human_img, garment_des, category).
REPLICATE_API_TOKEN=
REPLICATE_TRYON_VERSION=
