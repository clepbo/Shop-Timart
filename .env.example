# ---- Required in production ----
# Password for the owner's Studio at /admin. The default (timart-admin) only works locally.
ADMIN_PASSWORD=change-me

# Public URL of the site, used for Paystack's return URL. Optional on Vercel (auto-detected).
NEXT_PUBLIC_SITE_URL=

# ---- Database: Neon Postgres ----
# Added automatically by the Vercel ↔ Neon integration. Without it, local JSON files are used.
DATABASE_URL=

# ---- File storage: Vercel Blob ----
# Added automatically when you connect a Blob store in Vercel. Without it, uploads go to /public/uploads.
BLOB_READ_WRITE_TOKEN=

# ---- Payments: Paystack (NGN) ----
# From Paystack Dashboard → Settings → API Keys & Webhooks. Use sk_test_… first, then sk_live_….
# Without it, checkout falls back to confirming orders on WhatsApp.
PAYSTACK_SECRET_KEY=

# ---- AI virtual try-on (optional) ----
# Without these, the Fit Studio shows illustrated previews.
REPLICATE_API_TOKEN=
REPLICATE_TRYON_VERSION=
